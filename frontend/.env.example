# ============================================================
# IntelliMeet Frontend — Environment Template
# Copy to .env. Only VITE_-prefixed variables reach the browser,
# so never put secrets here (no LiveKit API secret, ever).
# ============================================================

# Base URL of the backend API
VITE_API_URL=http://localhost:3001/api

# Google Sign-In client id (public, not a secret)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
