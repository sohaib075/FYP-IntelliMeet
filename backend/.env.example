# ============================================================
# IntelliMeet Backend — Environment Template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=3001

# ---------- MongoDB ----------
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/intellimeet

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# ---------- Security ----------
BCRYPT_SALT_ROUNDS=12

# ---------- CORS ----------
# Comma-separated list of allowed origins (any localhost port is allowed in development)
CORS_ORIGIN=http://localhost:5173

# ---------- Frontend ----------
# Public URL of the React app. Used for links in emails and meeting invitations.
FRONTEND_URL=http://localhost:5173

# ---------- Email (OTP + password reset) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ---------- Google Sign-In ----------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ---------- LiveKit (media server; required once the LiveKit migration lands) ----------
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # backend only — never expose to the frontend

# ---------- Azure AI Speech (real-time translation) ----------
# One Azure "Speech" resource powers BOTH speech-to-text and neural
# text-to-speech, so there is a single key/region pair rather than separate
# STT and TTS credentials.
#
# Where to get these:
#   portal.azure.com -> Create a resource -> "Speech" -> after it deploys,
#   open "Keys and Endpoint" and copy KEY 1 and the Location/Region.
#
# The key NEVER reaches the browser. The backend exchanges it for a
# short-lived authorisation token (see services/speechService.js).
#
# Leave these blank and the meeting works exactly as before — the AI panel
# simply reports that translation is not configured.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------- Translation provider (choose ONE) ----------
# Preferred: Azure Translator. portal.azure.com -> Create a resource ->
# "Translator". Region defaults to AZURE_SPEECH_REGION when left blank.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Alternative: Google Cloud Translation v2. Set this INSTEAD of the Azure
# Translator pair above; whichever is present is the one that gets used.
GOOGLE_TRANSLATE_API_KEY=
